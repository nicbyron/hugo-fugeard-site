---
// Version A, "Copper Table": warm cream, copper accents, arched photos (the doorway of a home).
import Photo from './Photo.astro';
import { emailUrl, getContent, homePath, otherLocale, site, whatsappUrl, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const wa = whatsappUrl(t.contact.whatsappMessage);
const mail = emailUrl(t.contact.emailSubject);
const year = new Date().getFullYear();
---

<header class="header">
  <a class="brand" href={homePath(locale)}>{site.name}</a>
  <nav aria-label="Menu">
    <a href="#about">{t.nav.about}</a>
    <a href="#approach">{t.nav.approach}</a>
    <a href="#process">{t.nav.process}</a>
    <a href="#faq">{t.nav.faq}</a>
    <a class="nav-cta" href="#contact">{t.nav.contact}</a>
  </nav>
  <a class="lang" href={homePath(otherLocale(locale))} hreflang={otherLocale(locale)}>{t.nav.language}</a>
</header>

<main id="main">
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1>{t.hero.title}</h1>
      <p class="lead">{t.hero.text}</p>
      <div class="buttons">
        <a class="button primary" href={wa} target="_blank" rel="noopener">{t.hero.primaryButton}</a>
        <a class="button ghost" href={mail}>{t.hero.secondaryButton}</a>
      </div>
    </div>
    <div class="arch hero-photo">
      <Photo file={t.hero.image} alt={t.hero.imageAlt} sizes="(min-width: 900px) 45vw, 100vw" loading="eager" />
    </div>
  </section>

  <section id="about" class="about">
    <div class="arch about-photo">
      <Photo file={t.about.image} alt={t.about.imageAlt} sizes="(min-width: 900px) 35vw, 100vw" />
    </div>
    <div>
      <h2>{t.about.title}</h2>
      {t.about.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section id="approach" class="approach">
    <h2>{t.approach.title}</h2>
    <p class="intro">{t.approach.intro}</p>
    <div class="cards">
      {
        t.approach.items.map((item, i) => (
          <article class="card">
            <span class="card-number">0{i + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))
      }
    </div>
    <div class="cuisines">
      <span class="cuisines-title">{t.approach.cuisinesTitle}</span>
      <ul>{t.approach.cuisines.map((c) => <li>{c}</li>)}</ul>
    </div>
  </section>

  <section class="gallery" aria-label={t.gallery.title}>
    <h2>{t.gallery.title}</h2>
    <div class="gallery-grid">
      {
        t.gallery.images.map((img) => (
          <figure>
            <Photo file={img.file} alt={img.alt} sizes="(min-width: 900px) 33vw, 50vw" />
          </figure>
        ))
      }
    </div>
  </section>

  <section id="process" class="process">
    <h2>{t.process.title}</h2>
    <p class="intro">{t.process.intro}</p>
    <ol class="steps">
      {
        t.process.steps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="faq" class="faq">
    <h2>{t.faq.title}</h2>
    <div class="faq-list">
      {
        t.faq.items.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section id="contact" class="contact">
    <h2>{t.contact.title}</h2>
    <p>{t.contact.text}</p>
    <div class="buttons">
      <a class="button light" href={wa} target="_blank" rel="noopener">{t.contact.whatsappButton}</a>
      <a class="button outline-light" href={mail}>{t.contact.emailButton}</a>
    </div>
    <p class="contact-email"><a href={mail}>{site.email}</a></p>
  </section>
</main>

<footer class="footer">
  <span>{site.name} · {t.footer.tagline}</span>
  <span>© {year} {site.name}. {t.footer.rights}</span>
</footer>

<a class="floating-wa" href={wa} target="_blank" rel="noopener" aria-label={t.hero.primaryButton}>
  <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 2.9 2.9 0 0 0-.9 2.2 5 5 0 0 0 1 2.7 11.6 11.6 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
</a>
