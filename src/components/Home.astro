---
// Version B, "Carnet": a chef's notebook. Paper white, olive and tomato, handwritten notes, a printed-menu feel.
import Photo from './Photo.astro';
import { emailUrl, getContent, homePath, otherLocale, site, whatsappUrl, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const wa = whatsappUrl(t.contact.whatsappMessage);
const mail = emailUrl(t.contact.emailSubject);
const year = new Date().getFullYear();
const [firstWords, ...restWords] = t.hero.title.split(',');
---

<header class="header">
  <a class="brand" href={homePath(locale)}>Hugo <em>Fugeard</em></a>
  <nav aria-label="Menu">
    <a href="#about">{t.nav.about}</a>
    <a href="#approach">{t.nav.approach}</a>
    <a href="#process">{t.nav.process}</a>
    <a href="#faq">{t.nav.faq}</a>
  </nav>
  <a class="lang" href={homePath(otherLocale(locale))} hreflang={otherLocale(locale)}>{t.nav.language}</a>
  <a class="header-cta" href="#contact">{t.nav.contact}</a>
</header>

<main id="main">
  <section class="hero">
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1>{firstWords}{restWords.length > 0 && <>,<em>{restWords.join(',')}</em></>}</h1>
    <p class="lead">{t.hero.text}</p>
    <div class="buttons">
      <a class="button primary" href={wa} target="_blank" rel="noopener">{t.hero.primaryButton}</a>
      <a class="button text" href={mail}>{t.hero.secondaryButton} →</a>
    </div>
  </section>

  <div class="hero-photo">
    <Photo file={t.hero.image} alt={t.hero.imageAlt} sizes="100vw" loading="eager" widths={[800, 1200, 1800, 2400]} />
  </div>

  <section id="about" class="about">
    <div class="about-text">
      <h2>{t.about.title}</h2>
      {t.about.paragraphs.map((p) => <p>{p}</p>)}
      <p class="signature">Hugo</p>
    </div>
    <div class="about-photo">
      <Photo file={t.about.image} alt={t.about.imageAlt} sizes="(min-width: 900px) 40vw, 100vw" />
    </div>
  </section>

  <section id="approach" class="approach">
    <div class="approach-head">
      <h2>{t.approach.title}</h2>
      <p class="intro">{t.approach.intro}</p>
    </div>
    <ol class="pillars">
      {
        t.approach.items.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="cuisines">
      <span class="note">{t.approach.cuisinesTitle}</span>
      {t.approach.cuisines.join(' · ')}
    </p>
  </section>

  <section class="gallery" aria-label={t.gallery.title}>
    <h2 class="note gallery-title">{t.gallery.title}</h2>
    <div class="strip">
      {
        t.gallery.images.map((img) => (
          <figure>
            <Photo file={img.file} alt={img.alt} sizes="(min-width: 900px) 30vw, 75vw" />
          </figure>
        ))
      }
    </div>
  </section>

  <section id="process" class="process">
    <div class="menu-card">
      <h2>{t.process.title}</h2>
      <p class="intro">{t.process.intro}</p>
      <ol>
        {
          t.process.steps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="faq" class="faq">
    <h2>{t.faq.title}</h2>
    <div class="faq-list">
      {
        t.faq.items.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section id="contact" class="contact">
    <p class="note">{site.email}</p>
    <h2>{t.contact.title}</h2>
    <p class="contact-text">{t.contact.text}</p>
    <div class="buttons">
      <a class="button primary" href={wa} target="_blank" rel="noopener">{t.contact.whatsappButton}</a>
      <a class="button outline" href={mail}>{t.contact.emailButton}</a>
    </div>
  </section>
</main>

<footer class="footer">
  <span>{site.name} · {t.footer.tagline}</span>
  <span>© {year}. {t.footer.rights}</span>
</footer>
